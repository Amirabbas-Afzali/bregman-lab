#!/bin/bash
# Arena-Hard v0.1 GENERATION for the 8B LoRA RKL policies, seeds 1 and 2 (amari vs canon).
# Generation flags are byte-identical to jobs/gen_lora8b.slrm, which produced the seed-0 answers, so
# these are judgeable against the same baseline. The policy dirs are ordinary causal-LM dirs —
# stage_b_train.py calls merge_and_unload() before saving under LoRA.
#
# PROMPTS. data/arena_hard_v01.jsonl was not in this clone (it lives only in talium's private scratch).
# It was refetched from the canonical source, lm-sys/arena-hard-auto @ data/arena-hard-v0.1/question.jsonl:
# 500 questions, 500 unique uids. Judging matches on uid, so order does not matter — but if Taehyun's
# copy is a subset or a variant, the uid sets must be reconciled before the win rates are comparable.
#
# ARRAY. idx%2 -> norm (0=amari, 1=canon); 1 + idx/2 -> seed (1,2). Same convention as the training array.
# Out: jobs/lora_rkl_8b/lora8b_kl_{amari,canon}_bdpo_s{1,2}.jsonl
# Submit FROM llm/:  sbatch jobs/lora_rkl_8b/gen_lora8b_rkl_seeds.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=glora8bS
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-3
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=8:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"     # same stack the policies were trained under
cd "$REPO/llm"

NORMS=(amari canon); NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"
SEED=$((1 + SLURM_ARRAY_TASK_ID / 2)); DIV=kl
POL="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}/stageB_lora8b_${DIV}_${NORM}_bdpo_token_s${SEED}_policy"
TAG="lora8b_${DIV}_${NORM}_bdpo_s${SEED}"
OUT="jobs/lora_rkl_8b/${TAG}.jsonl"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "$OUT"
echo "=== done $TAG -> $OUT | $(date) ==="
