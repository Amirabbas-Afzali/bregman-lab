#!/bin/bash
# SMOKE — 1.7B LoRA, Ω=RKL (--div kl), seed 0, 6 steps. Two questions at once:
#   1. s/step, to size the walltime for the real run (1.7B full-FT was 14.3 h; LoRA is new here)
#   2. whether gradient checkpointing can be turned OFF on an L40S at this scale. At 8B it needs
#      ~52 G and OOMs (job 5487546); 1.7B has ~1/4 the activations, so it may fit and run ~25% faster.
# The fp32 [T,V] logits do NOT shrink with the model — Qwen3-1.7B has the same 151,936 vocab — so the
# saving is smaller than the parameter ratio suggests.
#
# ARRAY. idx%2 -> norm (0=amari, 1=canon); idx/2 -> 0=checkpointing ON, 1=OFF.
# Submit FROM llm/:  sbatch jobs/div_sweep_1.7b/smoke_1p7b_lora_rkl.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sm17bL
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-3
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=0:30:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"
cd "$REPO/llm"
OUT_DIR="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}"; mkdir -p "$OUT_DIR"
export WANDB_DIR="/scratch/$USER/wandb"; mkdir -p "$WANDB_DIR"

NORMS=(amari canon)
NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"
if [ $((SLURM_ARRAY_TASK_ID / 2)) -eq 0 ]; then CKPT=""; TAG="ckpt"; else CKPT="--no-grad-checkpoint"; TAG="nockpt"; fi

echo "=== SMOKE 1.7B LoRA [kl, norm=$NORM, seed=0, $TAG] 1xL40S on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base --policy Qwen/Qwen3-1.7B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div kl --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  $CKPT --steps 6 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 64 --log-every 2 --eval-every 6 --seed 0 \
  --out "$OUT_DIR/smoke_lora1p7b_kl_${NORM}_${TAG}_s0"
echo "=== smoke done [$NORM, $TAG] | $(date) ==="
