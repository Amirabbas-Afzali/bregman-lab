#!/bin/bash
# 1.7B LoRA — Ω=RKL (--div kl), amari vs canonical, seeds 0, 1, 2.
#
# WHY. The 8B LoRA cell has three seeds (array 5492519 + Taehyun's seed 0). This is the 1.7B end of the
# same ladder, so the scaling trend is measured with one training method throughout rather than mixing
# full-FT and LoRA across sizes.
#
# RECIPE. Identical to jobs/stage_b_lora_8b_seeds.slrm apart from --ref/--policy (1.7B) and --out:
# same LoRA r/alpha/dropout, same beta/lr/schedule, same --grad-accum 64, same --clamp 15. Note
# grad-accum is the EFFECTIVE BATCH (pairs per optimizer step) and the micro-batch is always one pair,
# so raising it would change the optimization recipe without reducing wall time — total work is
# 61,135 x 2 epochs pairs either way. It is deliberately left at 64 to match every other cell.
#
# ARRAY. idx%2 -> norm (0=amari, 1=canon); idx/2 -> seed (0,1,2). 6 tasks.
# Submit FROM llm/:  sbatch jobs/div_sweep_1.7b/stage_b_lora_1p7b_rkl_seeds.slrm
#
# WALLTIME. Smoke (5528579) measured 35.8 s/step WITHOUT gradient checkpointing (20.4 G peak, fits the
# L40S with room). 1,910 steps => ~19.5 h; --time 24:00:00 leaves ~20% margin. With checkpointing ON
# it is 59.5 s/step => ~32 h, which would need the 3-day tier.
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=l17bS
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-5
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"        # Taehyun's seed-0 stack: torch 2.9.1 / transformers 5.14.1 / flash-attn 2.8.3
cd "$REPO/llm"
OUT_DIR="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}"; mkdir -p "$OUT_DIR"   # NEVER /project
export WANDB_DIR="/scratch/$USER/wandb"; mkdir -p "$WANDB_DIR"

DIV=kl                                     # code key kl == reverse KL (SHORT maps kl->RKL, rkl->FKL)
NORMS=(amari canon)
NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"
SEED=$((SLURM_ARRAY_TASK_ID / 2))
RUN="1p7b_lora_${DIV}_${NORM}_s${SEED}"

echo "=== 1.7B LoRA [$DIV, norm=$NORM, seed=$SEED] 1xL40S (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train_wandb.py \
  --ref Qwen/Qwen3-1.7B-Base --policy Qwen/Qwen3-1.7B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 100 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --no-grad-checkpoint --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed "$SEED" --save-policy \
  --wandb-project "Off-policy KL" --wandb-entity amir8afzali-sharif-university-of-technology \
  --wandb-name "$RUN" \
  --out "$OUT_DIR/stageB_lora1p7b_${DIV}_${NORM}_bdpo_token_s${SEED}"
echo "=== done 1.7B LoRA [$DIV, norm=$NORM, seed=$SEED] | $(date) ==="
