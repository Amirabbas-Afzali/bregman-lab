#!/bin/bash
# Arena-Hard v0.1 GENERATION for the 1.7B LoRA RKL policies, seeds 0/1/2 (amari vs canon).
# Generation flags are byte-identical to jobs/gen_lora8b.slrm, so these answers are judgeable against
# the same baseline as every other cell in the ladder.
#
# ARRAY. idx%2 -> norm (0=amari, 1=canon); idx/2 -> seed (0,1,2). 6 arms.
#   NOTE idx 2 (amari, seed 1): its training job 5528664_2 hit NODE_FAIL after saving, was requeued,
#   and the rerun overwrites that policy when it lands. Submit idx 2 only after the rerun finishes:
#       sbatch --array=2 jobs/div_sweep_1.7b/gen_lora1p7b_rkl_seeds.slrm
#
# Out: jobs/div_sweep_1.7b/lora1p7b_kl_{amari,canon}_bdpo_s{0,1,2}.jsonl
# Submit FROM llm/:  sbatch --array=0,1,3,4,5 jobs/div_sweep_1.7b/gen_lora1p7b_rkl_seeds.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=glora17b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-5
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"     # same stack the policies were trained under
cd "$REPO/llm"

NORMS=(amari canon); NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"
SEED=$((SLURM_ARRAY_TASK_ID / 2)); DIV=kl
POL="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}/stageB_lora1p7b_${DIV}_${NORM}_bdpo_token_s${SEED}_policy"
TAG="lora1p7b_${DIV}_${NORM}_bdpo_s${SEED}"
OUT="jobs/div_sweep_1.7b/${TAG}.jsonl"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "$OUT"
echo "=== done $TAG -> $OUT | $(date) ==="
