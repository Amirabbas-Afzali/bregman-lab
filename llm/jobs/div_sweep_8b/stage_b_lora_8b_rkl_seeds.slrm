#!/bin/bash
# 8B LoRA — Ω=FKL (--div rkl), amari vs canonical, seeds 0 and 1.
#
# WHY. The 8B RKL cell now has three seeds (Taehyun's seed 0 + seeds 1-2, array 5492519). This extends
# the amari-vs-canonical comparison to the other five f-divergences at the same scale, n=2 seeds each.
# Recipe is identical to jobs/stage_b_lora_8b_seeds.slrm apart from --div: same LoRA rank/alpha/dropout,
# same beta/lr/schedule/accum/clamp, same data. --clamp 15 is the heavy-tail guard and divergences.py
# documents it as "identical for every Ω", so it is NOT retuned per divergence.
#
# GRADIENT CHECKPOINTING IS ON (no --no-grad-checkpoint). Turning it off needs ~52 G and OOMs on the
# L40S's 44.4 GiB usable — measured, job 5487546. It is only an option on H100.
#
# ARRAY. idx%2 -> norm (0=amari, 1=canon); idx/2 -> seed (0,1). Same convention as the RKL seeds script.
# Submit FROM llm/:  sbatch jobs/div_sweep_8b/$(basename "$0")
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=l8brkl
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-3
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=68:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"        # Taehyun's seed-0 stack: torch 2.9.1 / transformers 5.14.1 / flash-attn 2.8.3
cd "$REPO/llm"
OUT_DIR="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}"; mkdir -p "$OUT_DIR"   # NEVER /project
export WANDB_DIR="/scratch/$USER/wandb"; mkdir -p "$WANDB_DIR"

DIV=rkl
NORMS=(amari canon)
NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"
SEED=$((SLURM_ARRAY_TASK_ID / 2))
RUN="8b_lora_${DIV}_${NORM}_s${SEED}"

echo "=== 8B LoRA [$DIV (FKL), norm=$NORM, seed=$SEED] 1xL40S (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train_wandb.py \
  --ref Qwen/Qwen3-8B-Base --policy Qwen/Qwen3-8B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 100 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed "$SEED" --save-policy \
  --wandb-project "Off-policy KL" --wandb-entity amir8afzali-sharif-university-of-technology \
  --wandb-name "$RUN" \
  --out "$OUT_DIR/stageB_lora8b_${DIV}_${NORM}_bdpo_token_s${SEED}"
echo "=== done 8B LoRA [$DIV, norm=$NORM, seed=$SEED] | $(date) ==="
