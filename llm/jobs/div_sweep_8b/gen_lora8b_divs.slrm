#!/bin/bash
# Arena-Hard v0.1 GENERATION for the 8B LoRA divergence sweep: 5 Ω x {amari,canon} x seeds {0,1} = 20.
# Generation flags are byte-identical to jobs/gen_lora8b.slrm (which produced the RKL seed-0 answers),
# so every answer file in the ladder is judgeable against the same baseline.
#
# ARRAY. div = idx/4 over (adiv rkl js hel chi2); within each block r=idx%4: r%2 -> norm, r/2 -> seed.
#   0-3 adiv | 4-7 rkl | 8-11 js | 12-15 hel | 16-19 chi2
# Measured: 8B generation is ~45 min, so --time 2:00:00 keeps this in the 3 h tier (largest L40S pool).
# Out: jobs/div_sweep_8b/lora8b_<div>_{amari,canon}_bdpo_s{0,1}.jsonl
# Submit FROM llm/:  sbatch jobs/div_sweep_8b/gen_lora8b_divs.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=gl8bdiv
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-19
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=2:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_t0/bin/activate"     # same stack the policies were trained under
cd "$REPO/llm"

DIVS=(adiv rkl js hel chi2); NORMS=(amari canon)
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID / 4))]}"
R=$((SLURM_ARRAY_TASK_ID % 4))
NORM="${NORMS[$((R % 2))]}"; SEED=$((R / 2))
POL="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}/stageB_lora8b_${DIV}_${NORM}_bdpo_token_s${SEED}_policy"
TAG="lora8b_${DIV}_${NORM}_bdpo_s${SEED}"
OUT="jobs/div_sweep_8b/${TAG}.jsonl"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "$OUT"
echo "=== done $TAG -> $OUT | $(date) ==="
